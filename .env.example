# Local development (works immediately, no account needed)
DATABASE_URL=file:data/pos.db
DATABASE_AUTH_TOKEN=

# For hosted deployment, use a PostgreSQL database (e.g. Neon):
# DATABASE_URL=postgresql://user:password@your-host-pooler.region.aws.neon.tech/neondb?sslmode=require
# (DATABASE_AUTH_TOKEN is only needed for libSQL/Turso URLs)
# Legacy option: hosted libSQL/Turso also still works:
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=your_turso_auth_token

# Change this to a long random string in production
SESSION_SECRET=dev-only-change-this-secret

# Failed sign-ins per IP and username before a 15-minute lockout
LOGIN_MAX_ATTEMPTS=5

# Keep audit history for this many days (minimum 30)
AUDIT_RETENTION_DAYS=365

NEXT_PUBLIC_APP_NAME=Slawn POS

# Optional: S3 for product photo uploads. Leave empty to store compressed
# images inline with the product instead.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional CDN/public base URL for uploaded objects.
S3_PUBLIC_BASE_URL=
